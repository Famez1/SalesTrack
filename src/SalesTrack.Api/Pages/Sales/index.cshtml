@page
@model SalesTrack.Api.Pages.Sales.IndexModel
@{
    ViewData["Title"] = "Продажи";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SalesTrack</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

    <div class="container mt-4">
        <h1>Продажи</h1>

        <button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addSaleModal">
            Добавить запись о продаже
        </button>

        <div class="modal fade" id="addSaleModal" tabindex="-1" aria-labelledby="addSaleModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form id="addSaleForm" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="addSaleModalLabel">Добавить продажу</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                        </div>
                        <div class="modal-body">
                            <div id="saleItemsContainer">
                                <div class="sale-item mb-3 border p-2">
                                    <div class="mb-2">
                                        <label>Product ID</label>
                                        <input type="text" name="NewSale.SaledProducts[0].ProductId" class="form-control" required />
                                    </div>
                                    <div>
                                        <label>Количество</label>
                                        <input type="number" name="NewSale.SaledProducts[0].Quantity" class="form-control" required />
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-secondary" onclick="addProductItem()">Добавить ещё товар</button>

                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Общая сумма</th>
                    <th>Товары</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sale in Model.Sales)
                {
                    <tr>
                        <td>@sale.Date.ToString("dd.MM.yyyy")</td>
                        <td>@sale.TotalAmount.ToString("C")</td>
                        <td>
                            <ul>
                                @foreach (var item in sale.SaleItems)
                                {
                                    <li>
                                        ID: @item.ProductId<br />
                                        Кол-во: @item.Quantity<br />
                                        Цена за шт: @item.UnitPrice.ToString("C")<br />
                                        Сумма: @item.TotalePrice.ToString("C")
                                    </li>
                                }
                            </ul>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between mt-3">
            <form method="get">
                <input type="hidden" name="limit" value="@Model.Limit" />
                <input type="hidden" name="offset" value="@(Math.Max((Model.Offset ?? 0) - (Model.Limit ?? 10), 0))" />
                <button type="submit" class="btn btn-primary" @(Model.Offset == 0 ? "disabled" : "")>Назад</button>
            </form>

            <form method="get">
                <input type="hidden" name="limit" value="@Model.Limit" />
                <input type="hidden" name="offset" value="@( (Model.Offset ?? 0) + (Model.Limit ?? 10) )" />
                <button type="submit" class="btn btn-primary" @(Model.Sales.Count < (Model.Limit ?? 10) ? "disabled" : "")>Вперёд</button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function addProductItem() {
            const container = document.getElementById('saleItemsContainer');
            const newItem = document.createElement('div');
            newItem.classList.add('sale-item', 'mb-3', 'border', 'p-2');
            newItem.innerHTML = `
                    <div class="mb-2">
                        <label>Product ID</label>
                        <input type="text" name="ProductId" class="form-control" required />
                    </div>
                    <div>
                        <label>Количество</label>
                        <input type="number" name="Quantity" class="form-control" required />
                    </div>
                `;
            container.appendChild(newItem);
        }
    </script>

</body>
</html>
