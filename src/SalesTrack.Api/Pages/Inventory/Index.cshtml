@page
@model SalesTrack.Api.Pages.Inventory.IndexModel
@{
    ViewData["Title"] = "Склад";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SalesTrack</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-4">
        <h1>Склад</h1>

        <div class="mb-3 d-flex justify-content-between align-items-center">
            <form method="get" class="d-flex align-items-center gap-2">
                <input type="text" name="Search" value="@Model.Search" placeholder="Поиск по названию товара" class="form-control" />
                <input type="hidden" name="Limit" value="@Model.Limit" />
                <input type="hidden" name="Offset" value="0" />
                <button type="submit" class="btn btn-primary">Поиск</button>
            </form>

            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addInventoryModal">Добавить товар</button>
        </div>

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Название товара</th>
                    <th>Количество на складе</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Inventories.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="text-center">Товары не найдены</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Inventories)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between mt-3">
            <form method="get">
                <input type="hidden" name="Search" value="@Model.Search" />
                <input type="hidden" name="Limit" value="@Model.Limit" />
                <input type="hidden" name="Offset" value="@(Math.Max((Model.Offset ?? 0) - (Model.Limit ?? 10), 0))" />
                <button type="submit" class="btn btn-primary" @(Model.Offset == 0 ? "disabled" : "")>Назад</button>
            </form>

            <form method="get">
                <input type="hidden" name="Search" value="@Model.Search" />
                <input type="hidden" name="Limit" value="@Model.Limit" />
                <input type="hidden" name="Offset" value="@( (Model.Offset ?? 0) + (Model.Limit ?? 10) )" />
                <button type="submit" class="btn btn-primary" @(Model.Inventories.Count < (Model.Limit ?? 10) ? "disabled" : "")>Вперёд</button>
            </form>
        </div>
    </div>

    <div class="modal fade" id="addInventoryModal" tabindex="-1" aria-labelledby="addInventoryModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form id="addInventoryForm" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addInventoryModalLabel">Добавить товар на склад</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="productIdInput" class="form-label">ID товара (ProductId)</label>
                        <input type="text" id="productIdInput" name="ProductId" class="form-control" placeholder="Введите GUID товара" required />
                        <div class="form-text">Введите уникальный идентификатор товара (GUID)</div>
                    </div>
                    <div class="mb-3">
                        <label for="quantityInput" class="form-label">Количество</label>
                        <input type="number" id="quantityInput" name="Quantity" class="form-control" min="1" required />
                    </div>
                    <div id="addInventoryError" class="text-danger d-none"></div>
                    <div id="addInventorySuccess" class="text-success d-none">Товар успешно добавлен!</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">Добавить</button>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const addInventoryForm = document.getElementById('addInventoryForm');
        const errorDiv = document.getElementById('addInventoryError');
        const successDiv = document.getElementById('addInventorySuccess');

        addInventoryForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            errorDiv.classList.add('d-none');
            successDiv.classList.add('d-none');

            const formData = new FormData(addInventoryForm);
            const productId = formData.get('ProductId');
            const quantity = formData.get('Quantity');

            if (!productId || !quantity) {
                errorDiv.textContent = 'Пожалуйста, заполните все поля.';
                errorDiv.classList.remove('d-none');
                return;
            }

            try {
                const response = await fetch('/api/v1/Inventory', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        productId: productId,
                        quantity: parseInt(quantity)
                    })
                });

                if (response.ok) {
                    successDiv.classList.remove('d-none');
                    addInventoryForm.reset();

                    setTimeout(() => {
                        const modal = bootstrap.Modal.getInstance(document.getElementById('addInventoryModal'));
                        modal.hide();

                        window.location.reload();
                    }, 1000);
                } else {
                    const errorData = await response.json();
                    errorDiv.textContent = errorData?.message || 'Ошибка при добавлении товара';
                    errorDiv.classList.remove('d-none');
                }
            } catch (ex) {
                errorDiv.textContent = 'Ошибка при отправке запроса: ' + ex.message;
                errorDiv.classList.remove('d-none');
            }
        });
    </script>
</body>
</html>
