@page
@model SalesTrack.Api.Pages.IndexModel
@{
    ViewData["Title"] = "Главная";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - SalesTrack</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #e8f0fe; /* нежно-голубой фон */
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Главная</h1>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <form method="get" action="/Categories/Index">
                    <input type="hidden" name="limit" value="10" />
                    <input type="hidden" name="offset" value="0" />
                    <input type="hidden" name="direction" value="Asc" />
                    <button type="submit" class="btn btn-primary w-100 py-4 fs-3">
                        Категории
                    </button>
                </form>
            </div>

            <div class="col-md-6">
                <form method="get" action="/Products/Index">
                    <button type="submit" class="btn btn-info w-100 py-4 fs-3 text-white">
                        Продукты
                    </button>
                </form>
            </div>

            <div class="col-md-6">
                <form method="get" action="/Sales/Index">
                    <input type="hidden" name="limit" value="10" />
                    <input type="hidden" name="offset" value="0" />
                    <input type="hidden" name="direction" value="Asc" />
                    <button type="submit" class="btn btn-success w-100 py-4 fs-3">
                        Продажи
                    </button>
                </form>
            </div>

            <div class="col-md-6">
                <form method="get" action="/Inventory/Index">
                    <button type="submit" class="btn btn-secondary w-100 py-4 fs-3">
                        Склад
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
